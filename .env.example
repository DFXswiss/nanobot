ANTHROPIC_API_KEY=sk-ant-your_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_IDS=your_telegram_user_id   # comma-separated, multiple allowed
GH_TOKEN=ghp_your_github_pat_here
GPG_PRIVATE_KEY=            # optional: ASCII-armored GPG private key for commit signing
TELEGRAM_GROUP_POLICY=      # optional: "mention" (default — only @mentions trigger) or "open" (every group message triggers). DMs always work.
